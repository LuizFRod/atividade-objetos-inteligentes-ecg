  {
    "id": "7fce7544b28148a4",
    "type": "function",
    "z": "2f5e91a7ff3f40ca",
    "x": 470,
    "y": 200,
    "wires": [
      [
        "358fa33c86754a21"
      ],
      [
        "7d2aa36a39c54104"
      ]
    ],
    "name": "Validar lote e contato simulado",
    "func": "// indice é preservado como metadado: não assume contador de lote ou de amostra.\nfunction invalid(reason) { node.error('Lote ECG inválido: ' + reason, msg); return null; }\nlet p;\ntry { p = typeof msg.payload === 'string' ? JSON.parse(msg.payload) : msg.payload; }\ncatch (e) { return invalid('JSON malformado'); }\nif (!p || typeof p !== 'object' || Array.isArray(p)) return invalid('esperado objeto');\nif (p.dispositivo !== 'esp32-84729') return invalid('dispositivo deve ser esp32-84729');\nif (!Number.isSafeInteger(p.indice) || p.indice < 0) return invalid('indice deve ser inteiro >= 0');\nif (typeof p.intervalo_us !== 'number' || !Number.isFinite(p.intervalo_us) || p.intervalo_us <= 0 || p.intervalo_us > 1000000) return invalid('intervalo_us deve ser > 0 e <= 1000000');\nif (!Object.prototype.hasOwnProperty.call(p, 'eletrodos')) return invalid('eletrodos ausente');\nif (!Array.isArray(p.amostras) || p.amostras.length < 1 || p.amostras.length > 4096 || !p.amostras.every(v => typeof v === 'number' && Number.isFinite(v))) return invalid('amostras deve conter de 1 a 4096 números finitos');\nif (p.eletrodos !== 'conectados' && p.eletrodos !== 'desconectados' && !(p.eletrodos && p.eletrodos.origem === 'teste Node-RED')) return invalid('estado de eletrodos desconhecido');\nconst now = Date.now();\nflow.set('ecgLastRx', now);\nflow.set('ecgTimeoutMs', Math.max(10000, p.amostras.length * p.intervalo_us / 1000 * 3));\nif (p.eletrodos === 'desconectados') {\n  const first = !context.get('leadOff');\n  context.set('leadOff', true);\n  context.set('lastPoint', null);\n  node.status({fill:'red', shape:'ring', text:'eletrodos simulados desconectados'});\n  return [first ? {payload:[], topic:p.dispositivo} : null,\n    {payload:'AD8232 SIMULADO | eletrodos desconectados | LED aceso | traçado suspenso'}];\n}\ncontext.set('leadOff', false);\nconst dt = p.intervalo_us / 1000;\nconst previous = context.get('lastPoint');\n// Primeira amostra ancorada à chegada. Gaps de rede permanecem visíveis.\nlet start = now - (p.amostras.length - 1) * dt;\nif (Number.isFinite(previous)) start = Math.max(start, previous + dt);\nconst points = p.amostras.map((y, i) => ({x: start + i * dt, y}));\ncontext.set('lastPoint', points[points.length - 1].x);\nflow.set('ecgLastRx', now);\nflow.set('ecgTimeoutMs', Math.max(10000, p.amostras.length * dt * 3));\nnode.status({fill:'green', shape:'dot', text:p.amostras.length + ' amostras | índice ' + p.indice});\nreturn [\n {topic:p.dispositivo, payload:points, action:'append'},\n {payload:'Dispositivo: ' + p.dispositivo + ' | índice: ' + p.indice + ' | ' + p.amostras.length + ' amostras | ' + (1000000 / p.intervalo_us).toFixed(1) + ' Hz | eletrodos: ' + JSON.stringify(p.eletrodos)}\n];",
    "outputs": 2,
    "timeout": 0,
    "noerr": 0,
    "initialize": "context.set('lastPoint', null); flow.set('ecgLastRx', null); flow.set('ecgTimeoutMs', 10000); context.set('leadOff', false);",
    "finalize": "",
    "libs": []
  },
